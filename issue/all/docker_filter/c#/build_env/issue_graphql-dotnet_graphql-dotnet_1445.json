  "dockerfile": "FROM mcr.microsoft.com/dotnet/sdk:6.0\n\n# Set working directory\nWORKDIR /app\n\n# Install Git\nRUN apt-get update && \\\n    apt-get install -y git && \\\n    apt-get clean && \\\n    rm -rf /var/lib/apt/lists/*\n\n# Clone the repository and checkout the specific commit\nRUN git clone https://github.com/graphql-dotnet/graphql-dotnet.git . && \\\n    git checkout aed5298a435012d41d42dd0a9accebdb3cff1de3\n\n# Restore NuGet packages for all projects in the solution\nRUN dotnet restore src/GraphQL.sln\n\n# Build the solution\nRUN dotnet build src/GraphQL.sln --configuration Release --no-restore\n\n# Set the entry point to keep the container running\nENTRYPOINT [\"tail\", \"-f\", \"/dev/null\"]",
